[Unit]
Description=Probolos USB authorization gate
Documentation=https://github.com/capitan0n/probolos
# udev must be up: the whole design depends on receiving attach events, and
# starting before it would mean missing devices attached during boot.
After=systemd-udevd.service systemd-logind.service
Wants=systemd-udevd.service

[Service]
Type=simple
# --privsep is not optional here. As a long-running service the analyzer would
# otherwise sit as root for weeks; the split keeps that surface to the
# separate gate (see SECURITY.md for what it does and does not bound).
#
# --agent-user IS REQUIRED HERE.
#
# At boot there is no graphical session, so the automatic detection in
# _active_session_user() finds nothing and SUDO_USER is unset under systemd.
# Without a usable account the gate runs with no desktop prompt at all, and
# with no terminal either (stdin is /dev/null): every new device is held
# blocked until somebody can be asked.
#
# So name the account whose desktop session may answer. Do it in a drop-in
# rather than by editing this file, so an update does not overwrite it:
#
#   sudo systemctl edit probolos.service
#
#   [Service]
#   Environment=PROBOLOS_AGENT_USER=yourname
#
# The placeholder is the analyzer's own account, deliberately: the gate never
# lets the account the analyzer runs as answer (that would be the analyzer
# approving its own questions), so a unit that was never configured fails the
# way it should -- visibly, with the gate still closed -- instead of handing
# the prompt to whichever account happened to be logged in when the service
# started. It used to be `nobody`, while the analyzer ran as `nobody` too;
# with the analyzer on its own account, `nobody` here would hand the prompt to
# every process running as `nobody`.
Environment=PROBOLOS_AGENT_USER=probolos
# Unbuffered: Python block-buffers a pipe, so without this nothing
# reached the journal until the process exited, and every line of a
# run arrived at once with the exit's timestamp.
Environment=PYTHONUNBUFFERED=1
# --privsep-user probolos: the analyzer's own system account, created from
# probolos.sysusers (install.sh does that). Not the default, the shared
# `nobody`: any process with the analyzer's uid can kill it, and every
# analyzer exit reopens the gate. The service does not start without it.
ExecStart=/usr/bin/python3 -m probolos --privsep --privsep-user probolos \
          --timeout 0 --agent --agent-user ${PROBOLOS_AGENT_USER}
Restart=on-failure
RestartSec=5

# ---------------------------------------------------------------------------
# Sandboxing.
#
# The gate legitimately needs root, so the question is not whether to drop
# privilege -- privsep already does that internally -- but how much of the
# system root can still reach. Each line below removes something Probolos has
# no business touching, so a compromise of even the privileged half is boxed in.
#
# What is deliberately NOT restricted is explained inline: over-tightening a
# unit until the service silently stops working is worse than not tightening it.
# ---------------------------------------------------------------------------

# Filesystem: everything read-only except the two paths that must be written.
ProtectSystem=strict
ProtectHome=yes
StateDirectory=probolos
StateDirectoryMode=0755
RuntimeDirectory=probolos
# 2750, not 0750: the setgid bit makes the agent socket inherit the desktop
# user's group (see agentlink.prepare_socket_dir). It must be set HERE, by
# systemd, because RestrictSUIDSGID=yes below refuses the service any chmod
# that carries it.
RuntimeDirectoryMode=2750
# /sys must be writable: the entire mechanism is writing `authorized` and
# `authorized_default`. This is the one broad permission the design requires,
# and it is why the privileged half is kept separate from the analyzer.
ProtectKernelTunables=no

# Kernel and hardware
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes
# Device access is restricted to the two classes actually needed: input nodes
# to observe behaviour, block devices to read a partition table. Everything
# else -- sound, video, tty, GPU, and the misc class (/dev/uinput, /dev/kvm,
# /dev/fuse ...) which nothing in Probolos opens -- is denied.
DevicePolicy=closed
DeviceAllow=char-input rw
DeviceAllow=block-* r

# Privileges: no path to gaining more than it starts with.
NoNewPrivileges=yes
# CAP_DAC_OVERRIDE and CAP_CHOWN are needed to prepare the state and runtime
# directories and hand them to the unprivileged analyzer before dropping.
# CAP_SETUID/SETGID are needed for that drop itself.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_CHOWN CAP_SETUID CAP_SETGID CAP_FOWNER
AmbientCapabilities=

# pyudev needs AF_NETLINK in the host network namespace to receive uevents.
# INET sockets are still excluded and IP traffic is denied below.
PrivateNetwork=no
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any

# Namespaces and execution
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @privileged
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM

# Keyring and IPC isolation
PrivateTmp=yes
PrivateMounts=yes
KeyringMode=private
ProtectProc=invisible
ProcSubset=pid

[Install]
WantedBy=multi-user.target
